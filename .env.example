# Deployment environment contract. Use server-side secrets; never NEXT_PUBLIC_ keys.
# For local Worker development prefer .dev.vars.example -> .dev.vars instead.
# For native Next.js/Vercel, copy this example to ignored .env.local.
# These three hosting values are required for Vercel even in sample mode:
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
PROOFPAY_OWNER_PASSWORD=""
# Use a random private owner password of at least 32 characters.
# Production and Preview should use separate databases and credentials.
# Real integrations are optional for sample hosting, required for real checks:
GEMINI_API_KEY=""
GEMINI_MODEL=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_INVOICER_EMAIL=""
# Sites-only seller allowlist; Vercel uses the owner password instead.
PROOFPAY_SELLER_USER_ID=""
PROOFPAY_PAYMENT_MODE=""
